# figma-cli — spec refresh, catalog build, binary build, tests.
# The spec is Figma's published OpenAPI; the embedded catalog is a derived
# artifact regenerated by scripts/build-catalog (never hand-edited).

SPECS_DIR := specs
SPEC_URL  := https://raw.githubusercontent.com/figma/rest-api-spec/main/openapi/openapi.yaml

.PHONY: specs catalog build test fmt vet check

## specs: re-pull the Figma OpenAPI spec and regenerate SOURCES.md provenance
specs:
	curl -sSL -o $(SPECS_DIR)/figma-openapi.yaml "$(SPEC_URL)"
	go run ./scripts/gen-sources $(SPECS_DIR)/figma-openapi.yaml "$(SPEC_URL)"

## catalog: distill the embedded operation catalog from the spec
catalog:
	go run ./scripts/build-catalog

## build: build the figma binary
build:
	CGO_ENABLED=0 go build -o figma .

## test: run the unit and command tests
test:
	go test ./...

## fmt: format all Go sources
fmt:
	gofmt -w .

## vet: run go vet
vet:
	go vet ./...

## check: the full local gate — catalog current, build, vet, test, fmt-clean
check: catalog build vet test
	@test -z "$$(gofmt -l .)" || { echo "gofmt: files need formatting"; gofmt -l .; exit 1; }
